# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,mjs}]
indent_size = 4

[*.{md,markdown}]
indent_size = 2
# Trailing spaces are meaningful line breaks in Markdown
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
