{
  "name": "little-learner-keys",
  "version": "1.0.0",
  "private": true,
  "description": "Toddler learning web app for GitHub Pages. No build step; npm is dev tooling only.",
  "scripts": {
    "serve": "node tools/serve.js",
    "typecheck": "tsc -p jsconfig.json",
    "contrast": "node tools/contrast.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:quick": "playwright test --project=chromium",
    "test:quiet": "playwright test --workers=2",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
